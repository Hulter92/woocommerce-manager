{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    "updater:default",
    "process:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*/*" }, { "url": "http://*/*" }]
    }
  ]
}
