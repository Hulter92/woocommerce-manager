{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*/*" }, { "url": "http://*/*" }]
    }
  ]
}
